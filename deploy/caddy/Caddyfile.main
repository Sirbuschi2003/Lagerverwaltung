{
    default_sni {$APP_HOST}
}

# Proxy-Snippet: Zertifikat-Download + API + Frontend
(app_proxy) {
    encode zstd gzip

    # Zertifikat zum Herunterladen anbieten (fuer Geraete-Installation)
    @rootcert path /rootCA-local.crt /rootCA-local.cer /server.crt /server.cer
    handle @rootcert {
        header {
            Content-Type "application/x-x509-ca-cert"
            Content-Disposition "attachment; filename=\"lagerverwaltung.cer\""
            X-Content-Type-Options "nosniff"
            Cache-Control "no-store"
        }
        root * /certs
        rewrite * /server.crt
        file_server
    }

    @api path /api/* /socket.io/*
    handle @api {
        reverse_proxy lager-backend:3000
    }

    handle {
        reverse_proxy lager-frontend:80
    }
}

# HTTP: Zertifikat-Download erlauben, alles andere auf HTTPS weiterleiten
http://{$APP_HOST} {
    @rootcert path /rootCA-local.crt /rootCA-local.cer /server.crt /server.cer
    handle @rootcert {
        header {
            Content-Type "application/x-x509-ca-cert"
            Content-Disposition "attachment; filename=\"lagerverwaltung.cer\""
            X-Content-Type-Options "nosniff"
            Cache-Control "no-store"
        }
        root * /certs
        rewrite * /server.crt
        file_server
    }
    redir https://{$APP_HOST}{uri} permanent
}

# HTTPS: Festes selbst-signiertes Zertifikat (einmalig generiert, aendert sich nie)
https://{$APP_HOST} {
    tls /certs/server.crt /certs/server.key

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "upgrade-insecure-requests"
    }

    import app_proxy
}
