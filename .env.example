# =============================================================
# Lagerverwaltung – Konfigurationsvorlage
# Datei kopieren: cp .env.example .env  und ALLE Werte anpassen
# =============================================================

# --- Ports ---
MYSQL_PORT=3307
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# --- Datenbank (SICHERHEIT: starke Passwoerter verwenden!) ---
MYSQL_ROOT_PASSWORD=AENDERN_min20Zeichen_zufaellig
MYSQL_DATABASE=kfz_parts
MYSQL_USER=kfzparts
MYSQL_PASSWORD=AENDERN_min20Zeichen_zufaellig

# --- Backend ---
BACKEND_PORT=3001
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# JWT-Secret: MUSS ein zufaelliger String mit min. 32 Zeichen sein!
# Generieren mit: openssl rand -hex 32
BACKEND_JWT_SECRET=AENDERN_min32Zeichen_openssl_rand_hex_32
BACKEND_JWT_EXPIRES_IN=8h
BACKEND_JWT_REFRESH_EXPIRES_IN=7d

# HMAC-Secret fuer Inventur-Checksummen (tamper-evident, GoBD-Sicherheit)
# Generieren mit: openssl rand -hex 32
# PFLICHT fuer Produktion – ohne diesen Wert ist der Fallback unsicher!
INVENTORY_HMAC_SECRET=AENDERN_min32Zeichen_openssl_rand_hex_32

# --- CORS: erlaubte Frontend-Origins (kommagetrennt) ---
# Beispiel: https://meine-domain.de,https://app.meine-domain.de
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Dateiablage (Host-Pfade fuer Docker-Mounts, optional) ---
# Wenn nicht gesetzt: Docker-Named-Volumes (Daten bleiben bei Rebuilds erhalten)
# Fuer NAS-Zugriff per SMB auf Host-Pfade zeigen, z.B.:
# BACKUP_STORAGE_HOST_PATH=/volume1/docker/Lagerverwaltung/backups
# PURCHASE_ORDER_STORAGE_HOST_PATH=/volume1/docker/Lagerverwaltung/purchase-orders
BACKUP_STORAGE_HOST_PATH=
PURCHASE_ORDER_STORAGE_HOST_PATH=

# --- Web Push (VAPID) – fuer Hintergrund-Push-Benachrichtigungen ---
# Generieren mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
