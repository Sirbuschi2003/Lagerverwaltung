# =============================================================
# Lagerverwaltung – Konfigurationsvorlage
# Datei kopieren: cp .env.example .env  und ALLE Werte anpassen
# =============================================================

# --- Ports ---
MYSQL_PORT=3307
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# --- Datenbank (SICHERHEIT: starke Passwoerter verwenden!) ---
MYSQL_ROOT_PASSWORD=AENDERN_min20Zeichen_zufaellig
MYSQL_DATABASE=lagerverwaltung
MYSQL_USER=lagerverwaltung
MYSQL_PASSWORD=AENDERN_min20Zeichen_zufaellig

# --- Backend ---
BACKEND_PORT=3001
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# --- Datenbank Performance-Tuning ---
# DB_POOL_SIZE: TypeORM Connection-Pool (Standard: 30, fuer 200 User: 50)
DB_POOL_SIZE=30
# MYSQL_MAX_CONNECTIONS: Max. gleichzeitige Verbindungen in MySQL (>= DB_POOL_SIZE * Anzahl Backend-Instanzen)
MYSQL_MAX_CONNECTIONS=200
# MYSQL_INNODB_BUFFER_POOL_SIZE: Haupt-Cache fuer InnoDB (70% des verfuegbaren RAM empfohlen)
# NAS mit 4 GB RAM → 512M, NAS mit 8 GB RAM → 2G, Server mit 16 GB → 4G
MYSQL_INNODB_BUFFER_POOL_SIZE=512M

# JWT-Secret: MUSS ein zufaelliger String mit min. 32 Zeichen sein!
# Generieren mit: openssl rand -hex 32
BACKEND_JWT_SECRET=AENDERN_min32Zeichen_openssl_rand_hex_32
BACKEND_JWT_EXPIRES_IN=8h
BACKEND_JWT_REFRESH_EXPIRES_IN=7d

# HMAC-Secret fuer Inventur-Checksummen (tamper-evident, GoBD-Sicherheit)
# Generieren mit: openssl rand -hex 32
# PFLICHT fuer Produktion – ohne diesen Wert ist der Fallback unsicher!
INVENTORY_HMAC_SECRET=AENDERN_min32Zeichen_openssl_rand_hex_32

# --- CORS: erlaubte Frontend-Origins (kommagetrennt) ---
# Beispiel: https://meine-domain.de,https://app.meine-domain.de
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Dateiablage (Host-Pfade fuer Docker-Mounts, optional) ---
# Wenn nicht gesetzt: Docker-Named-Volumes (Daten bleiben bei Rebuilds erhalten)
# Fuer NAS-Zugriff per SMB auf Host-Pfade zeigen, z.B.:
# BACKUP_STORAGE_HOST_PATH=/volume1/docker/Lagerverwaltung/backups
# PURCHASE_ORDER_STORAGE_HOST_PATH=/volume1/docker/Lagerverwaltung/purchase-orders

PURCHASE_ORDER_STORAGE_HOST_PATH=
# Artikelbilder (JPEG, max 800×800px, automatisch skaliert)
# Beispiel: ITEM_IMAGE_STORAGE_HOST_PATH=/volume1/docker/Lagerverwaltung/item-images
ITEM_IMAGE_STORAGE_HOST_PATH=

# --- Web Push (VAPID) – fuer Hintergrund-Push-Benachrichtigungen ---
# Generieren mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- In-App Update (automatisches Docker-Update) ---
# GitHub Container Registry: Pakete muessen PUBLIC sein (GitHub → Packages → Visibility: Public)
# Oder: docker login ghcr.io -u Sirbuschi2003 -p <GITHUB_TOKEN> vor dem ersten Start
# Kein Token noetig wenn Pakete oeffentlich sind.
#
# HOST_PROJECT_PATH: Absoluter Pfad des Projektverzeichnisses auf dem HOST-System.
# Wird fuer den Helper-Container-Volume-Mount beim In-App-Update benoetigt.
# Normalerweise wird dieser Pfad automatisch via Docker-Labels erkannt (kein Eintrag noetig).
# Nur setzen falls die automatische Erkennung fehlschlaegt (z.B. bei ungewoehnlicher Docker-Konfiguration).
# Beispiel fuer Synology NAS:
# HOST_PROJECT_PATH=/volume1/docker/Lagerverwaltung
HOST_PROJECT_PATH=
